# Database (Postgres). In production this is set automatically by the
# "Prisma Postgres" Netlify extension: DATABASE_URL is the pooled
# connection (used at runtime), DIRECT_URL is the direct connection
# (used by `prisma migrate deploy`). For local dev, point both at any
# Postgres instance (they can be identical if it has no pooler).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public base URL used to build the QR code / public menu links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET="change-me-to-a-long-random-string"

# Translation providers (optional but recommended for production). Tried in
# this order — Azure, then DeepL, then Google — falling through to the next
# automatically if one fails or is rate-limited, for the same call. Only
# the ones with a key set are tried at all. With none configured, published
# menus keep the original text in every language (clearly marked as "not
# yet translated") instead of showing fake translations.
AZURE_TRANSLATOR_KEY=""
# Required by Azure's per-resource (non-global) Translator keys; leave
# blank if using a "Global" resource, which doesn't need it.
AZURE_TRANSLATOR_REGION=""
DEEPL_API_KEY=""
GOOGLE_TRANSLATE_API_KEY=""

# Stripe billing (optional for local dev). Without STRIPE_SECRET_KEY and a
# price ID, clicking "Subscribe" activates the plan directly (dev-mode
# simulated checkout) so publish-gating can be built/tested without a real
# payment processor. Add real keys + prices to switch to live billing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENTIAL=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_HOSPITALITY=""
STRIPE_PRICE_MULTI_LOCATION=""
# Annual prices (10x the monthly price — 2 months free). Each is a
# separate Stripe Price object (recurring.interval = year) on the same
# product as its monthly counterpart.
STRIPE_PRICE_ESSENTIAL_ANNUAL=""
STRIPE_PRICE_BUSINESS_ANNUAL=""
STRIPE_PRICE_HOSPITALITY_ANNUAL=""
STRIPE_PRICE_MULTI_LOCATION_ANNUAL=""
